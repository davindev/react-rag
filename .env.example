# OpenAI 호환 엔드포인트면 공급자 교체 가능. 아래 값은 측정에 사용한 엘리스 ML API 기준이다.
# 엘리스는 모델(엔드포인트)마다 base_url이 다르므로 역할별로 지정한다.
# base_url 형식: https://mlapi.run/{endpoint-id}/v1  (모델 상세 > API 탭에서 확인)
LLM_API_KEY=

# 생성(답변) 모델
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://mlapi.run/531a1cc4-645e-46ed-8feb-6fb43bbd965d/v1

# 임베딩 모델 (1536차원 — OpenAI text-embedding-3-small 프록시)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://mlapi.run/b54ff33e-6d14-42df-93f9-0f1132160ee8/v1

# Judge(평가) 모델 — 생성과 다른 계열 (self-preference 완화)
JUDGE_MODEL=gemini-3.1-pro-preview
JUDGE_BASE_URL=https://mlapi.run/62e68635-5e4c-4490-a5d4-59528aec05d2/v1

# (선택) reranker 전용 모델 — 미지정 시 LLM_MODEL/LLM_BASE_URL 사용
# RERANK_MODEL=
# RERANK_BASE_URL=

# temperature를 지원하지 않는 reasoning 모델(쉼표 구분). temperature=0을 400으로 거부하는 모델.
# 실측: gpt-5.6-sol, claude-sonnet-5는 미지원 / gemini-3.1-pro-preview는 지원.
# (judge를 claude 계열로 바꾸면 여기에 추가할 것)
NO_TEMPERATURE_MODELS=gpt-5.6-sol

DATABASE_URL=postgres://rag:rag@localhost:5432/rag

PORT=3000

# --- 검색 튜닝 노브 (미지정 시 코드 기본값: dense / 5 / 0) ---
# 검색 전략: dense | hybrid | rerank | hybrid-rerank (검색 전략 실험 토글)
# RETRIEVER=dense
# 생성에 넘길 검색 컨텍스트 수
# TOP_K=5
# retrieval gate: top-1 점수가 이 값 미만이면 생성 없이 거부. 0 = 비활성.
# ⚠️ 점수 스케일이 retriever마다 다르다 — dense/rerank는 코사인(0~1), hybrid는 RRF(상한 ≈0.033).
#    threshold-tune.ts가 제안하는 값은 dense 기준이므로 hybrid에 그대로 쓰면 전량 거부된다.
# RETRIEVAL_MIN_SCORE=0
